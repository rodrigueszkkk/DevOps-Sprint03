# =====================================================================
# CONFIGURAÇÃO DE DEPLOY NA AZURE (EXEMPLO)
# Copie este arquivo para .env.azure para automatizar o deploy local:
# cp .env.azure.example .env.azure
#
# O arquivo .env.azure é ignorado pelo Git e NÃO será commitado.
# =====================================================================

# Seu número de RM (somente dígitos)
RM=

# Região da Azure autorizada pela assinatura (ex: eastus, mexicocentral, canadacentral, centralus)
LOCATION=eastus

# Senhas do Banco de Dados (opcional: se não preenchidas, o script solicita no terminal com digitação oculta)
# MYSQL_ROOT_PASS=
# MYSQL_USER_PASS=
